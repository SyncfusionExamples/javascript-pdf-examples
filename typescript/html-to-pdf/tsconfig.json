{
  "compilerOptions": {
    "target": "es2017",
    "module": "esnext",
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "lib": [
      "dom",
      "es2017"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}